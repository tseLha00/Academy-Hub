        <mxCell id="constraints-body" value="UNIQUE (training_id, learner_id).&#10;Statuses: TODO, IN_PROGRESS, BLOCKED, COMPLETED.&#10;Proposed initial learning status: TODO.&#10;Estimate required on learner creation/submission.&#10;Admin assignments and legacy rows may lack dates.&#10;Learners maintain their own assignment status/dates.&#10;Estimate must not precede a supplied start date.&#10;COMPLETED records the actual completed_at.&#10;Reopen clears completed_at: awaiting confirmation.&#10;Individual percentage progress is removed.&#10;Overall completed-versus-total overview remains." vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#64748B;">
          <mxGeometry x="650" y="1114" width="550" height="253" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="Reading the model" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#172554;">
          <mxGeometry x="40" y="990" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-body" value="PK = primary key; FK = foreign key; UQ = unique.&#10;NN = NOT NULL; ? = nullable / optional.&#10;1 : 0..* = one parent, zero or many child rows.&#10;Navy = existing entities and unchanged fields.&#10;Purple text/headers = planned changes/entities.&#10;Planned fields have proposed types and NN rules.&#10;? = storage nullable; API may require a value.&#10;User includes the profile extension from issue #45." vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#64748B;">
          <mxGeometry x="40" y="1024" width="550" height="184" as="geometry" />
        </mxCell>
        <mxCell id="notes-title" value="Other design rules and pending decisions" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=16;fontColor=#172554;">
          <mxGeometry x="1210" y="1080" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="notes-body" value="DATE = calendar date; TIMESTAMPTZ = instant.&#10;Training description: optional plain text / URLs.&#10;Description edits: creator only (planned).&#10;Approval is separate from learning status.&#10;REQUESTED / APPROVED / REJECTED: workflow pending.&#10;Recommendation visibility/selection: pending.&#10;News date: publication; Event date: start (proposed).&#10;Vacation: start_date &lt;= end_date (proposed).&#10;Vacation status and News/Event links: to agree." vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontColor=#64748B;">
          <mxGeometry x="1210" y="1114" width="450" height="207" as="geometry" />
        </mxCell>
        <mxCell id="source" value="Source: project requirements, existing entities/V1-V6 design and agreed feedback. Purple changes are not yet implemented. Permissions are enforced by the application." vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontColor=#64748B;">
          <mxGeometry x="40" y="1520" width="1600" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>